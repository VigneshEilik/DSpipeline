# ==============================================================================
# ModelOps Studio — Production Environment Configuration (.env.production.example)
# ==============================================================================
# IMPORTANT: Generate all secrets using high-entropy CSPRNG (e.g., `openssl rand -hex 32`)
# DO NOT commit real secrets or production credentials to source control.
# ==============================================================================

# Application Environment
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
PROJECT_NAME="ModelOps Studio"
ENABLE_DOCS_IN_PRODUCTION=false

# Security & Cryptography
# Generate with: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_HEX_32_CHAR_CRYPTOGRAPHIC_SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
SECURE_COOKIES=true
COOKIE_SAMESITE=lax

# Rate Limiting & Upload Constraints
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
MAX_UPLOAD_SIZE_BYTES=104857600
TRUSTED_HOSTS="app.modelops.internal,api.modelops.internal,localhost"
ALLOWED_ORIGINS="https://app.modelops.internal,https://modelops.yourdomain.com"

# Production PostgreSQL Database
# Format: postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
DATABASE_URL=postgresql+asyncpg://modelops_user:CHANGE_ME_STRONG_DB_PASS@postgres:5432/modelops_db
DATABASE_ECHO=false
DB_POOL_SIZE=25
DB_MAX_OVERFLOW=15
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Object Storage: MinIO / AWS S3
STORAGE_BACKEND=s3
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=modelops_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD
MINIO_BUCKET_NAME=modelops-artifacts
MINIO_SECURE=false

# Celery & Redis
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
CELERY_BROKER_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/1
USE_IN_PROCESS_WORKER=false

# MLflow Tracking Server
MLFLOW_TRACKING_URI=http://mlflow:5000

# Observability
PROMETHEUS_METRICS_ENABLED=true
