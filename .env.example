# ==========================================
# ModelOps Studio Environment Configuration
# ==========================================

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true
SECRET_KEY=change-me-to-a-secure-random-secret-key-min-32-chars
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# API Settings
API_V1_STR=/api/v1
PROJECT_NAME="ModelOps Studio"
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Database Configuration (PostgreSQL primary)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=modelops_db
# For async SQLAlchemy: postgresql+asyncpg://user:pass@host:port/db
# Local SQLite fallback for fast isolated tests: sqlite+aiosqlite:///./modelops_dev.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/modelops_db
TEST_DATABASE_URL=sqlite+aiosqlite:///./test_modelops.db

# Redis & Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Object Storage (MinIO / S3)
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=modelops-artifacts
MINIO_SECURE=false
# Local filesystem storage path fallback if MinIO not running
LOCAL_STORAGE_DIR=./storage

# MLflow Tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_ARTIFACT_ROOT=s3://modelops-artifacts/mlflow

# Observability
PROMETHEUS_METRICS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Frontend Configuration (for apps/web)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="ModelOps Studio"
